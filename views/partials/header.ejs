<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StudyAdda</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <nav class="appbar">
    <div class="appbar-brand">
      <span class="appbar-logo">SA</span>
      <div class="appbar-text">
        <a class="appbar-title" href="/materials">StudyAdda</a>
        <span class="appbar-subtitle">Smart notes hub</span>
      </div>
    </div>
    <div class="appbar-actions">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <% if (currentUser.role === 'admin') { %><a href="/admin" class="nav-link">Admin</a><% } %>
        <div class="profile-menu">
          <div class="profile-dropdown" id="profileDropdown">
            <a href="/favorites" class="nav-link">Favorites</a>
            <a href="/profile" class="dropdown-item">Profile</a>
            <a href="/profile#subscriptions" class="dropdown-item">Subscriptions</a>
            <a href="/profile#purchases" class="dropdown-item">Purchases</a>
            <form action="/logout" method="POST" style="margin:0"><button class="dropdown-item logout-item">Logout</button></form>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="nav-link">Login</a>
      <% } %>
    </div>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <button class="hamburger" id="hamburgerBtn">
        <span></span><span></span><span></span>
      </button>
    <% } %>
  </nav>
  <% if (typeof success !== 'undefined' && success && success.length) { %><p class="flash success"><%= success[0] %></p><% } %>
  <% if (typeof error !== 'undefined' && error && error.length) { %><p class="flash error"><%= error[0] %></p><% } %>
