<%- include('../partials/header') %>
<main class="container admin-page">
  <h1 class="admin-title">Admin Dashboard</h1>
  <p class="admin-subtitle">Manage academic structure, upload materials, and monitor subscriptions.</p>

  <div class="admin-layout">
    <aside class="panel admin-sidebar">
      <h3>Overview</h3>
      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <span class="admin-stat-label">Total Users</span>
          <strong><%= stats?.totalUsers || 0 %></strong>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-label">Active Subs</span>
          <strong><%= stats?.activeSubscriptions || 0 %></strong>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-label">Total Payments</span>
          <strong><%= stats?.totalPayments || 0 %></strong>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-label">Paying Users</span>
          <strong><%= stats?.payingUsers || 0 %></strong>
        </div>
      </div>

      <h4 class="admin-nav-title">Navigate</h4>
      <nav class="admin-side-nav">
        <a href="#quick-add">Quick Add</a>
        <a href="#upload">Upload Material</a>
        <a href="#materials">Materials</a>
        <a href="#departments">Departments</a>
        <a href="#branches">Branches</a>
        <a href="#semesters">Semesters</a>
        <a href="#subjects">Subjects</a>
      </nav>
    </aside>

    <section class="admin-main">
      <section id="quick-add" class="grid-2">
        <div class="panel">
          <h3>Add Department</h3>
          <form method="POST" action="/admin/departments">
            <input name="name" placeholder="Engineering" required/>
            <button>Add Department</button>
          </form>
        </div>

        <div class="panel">
          <h3>Add Branch</h3>
          <form method="POST" action="/admin/branches">
            <input name="name" placeholder="ECE" required/>
            <select name="department" required>
              <% departments.forEach((d) => { %>
                <option value="<%= d._id %>"><%= d.name %></option>
              <% }) %>
            </select>
            <button>Add Branch</button>
          </form>
        </div>

        <div class="panel">
          <h3>Add Semester</h3>
          <form method="POST" action="/admin/semesters">
            <input name="name" placeholder="Semester 1" required/>
            <input name="number" type="number" min="1" max="20" required/>
            <select name="branch" required>
              <% branches.forEach((b) => { %>
                <option value="<%= b._id %>"><%= b.name %></option>
              <% }) %>
            </select>
            <button>Add Semester</button>
          </form>
        </div>

        <div class="panel">
          <h3>Add Subject</h3>
          <form method="POST" action="/admin/subjects">
            <input name="name" placeholder="Signals & Systems" required/>
            <input name="code" placeholder="ECE201"/>
            <select name="semester" required>
              <% semesters.forEach((s) => { %>
                <option value="<%= s._id %>"><%= s.name %> - <%= s.branch?.name || 'N/A' %></option>
              <% }) %>
            </select>
            <button>Add Subject</button>
          </form>
        </div>
      </section>

      <section id="upload" class="panel">
        <h3>Add Material</h3>
        <p class="admin-subtitle">Enter material name and select branch/semester. HTML file should already exist in the content folder.</p>
        <form method="POST" action="/admin/materials" class="grid-2">
          <input name="title" placeholder="Material Name (e.g., DataStructures)" required/>
          <select name="branch" required>
            <option value="">Select Branch</option>
            <% branches.forEach((b) => { %>
              <option value="<%= b._id %>"><%= b.name %></option>
            <% }) %>
          </select>
          <select name="semester" required>
            <option value="">Select Semester</option>
            <% semesters.forEach((s) => { %>
              <option value="<%= s._id %>"><%= s.name %></option>
            <% }) %>
          </select>
          <select name="subject" required>
            <option value="">Select Subject</option>
            <% subjects.forEach((s) => { %>
              <option value="<%= s._id %>"><%= s.name %></option>
            <% }) %>
          </select>
          <button type="submit" style="grid-column: span 2">Add Material</button>
        </form>
      </section>

      <section id="materials" class="panel">
        <h3>Materials</h3>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Title</th><th>Subject</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% materials.forEach((m) => { %>
                <tr>
                  <td><%= m.title %></td>
                  <td><%= m.subject?.name || 'N/A' %></td>
                  <td>
                    <form action="/admin/materials/<%= m._id %>?_method=DELETE" method="POST">
                      <button type="submit" onclick="return confirm('Delete this material?')">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section id="departments" class="panel">
        <h3>Departments</h3>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Name</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% departments.forEach((d) => { %>
                <tr>
                  <td>
                    <form action="/admin/departments/<%= d._id %>?_method=PUT" method="POST" class="inline-edit-form">
                      <input name="name" value="<%= d.name %>" required />
                      <button type="submit">Save</button>
                    </form>
                  </td>
                  <td>
                    <form action="/admin/departments/<%= d._id %>?_method=DELETE" method="POST">
                      <button type="submit" onclick="return confirm('Delete department?')">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section id="branches" class="panel">
        <h3>Branches</h3>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Name</th><th>Department</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% branches.forEach((b) => { const currentDepartmentId = b.department?._id ? b.department._id.toString() : (b.department ? b.department.toString() : ''); %>
                <tr>
                  <td>
                    <form action="/admin/branches/<%= b._id %>?_method=PUT" method="POST" class="inline-edit-form">
                      <input name="name" value="<%= b.name %>" required />
                  </td>
                  <td>
                      <select name="department" required>
                        <% departments.forEach((d) => { %>
                          <option value="<%= d._id %>" <%= currentDepartmentId === d._id.toString() ? 'selected' : '' %>><%= d.name %></option>
                        <% }) %>
                      </select>
                  </td>
                  <td>
                      <button type="submit">Save</button>
                    </form>
                    <form action="/admin/branches/<%= b._id %>?_method=DELETE" method="POST">
                      <button type="submit" onclick="return confirm('Delete branch?')">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section id="semesters" class="panel">
        <h3>Semesters</h3>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Name</th><th>Number</th><th>Branch</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% semesters.forEach((s) => { const currentBranchId = s.branch?._id ? s.branch._id.toString() : (s.branch ? s.branch.toString() : ''); %>
                <tr>
                  <td>
                    <form action="/admin/semesters/<%= s._id %>?_method=PUT" method="POST" class="inline-edit-form">
                      <input name="name" value="<%= s.name %>" required />
                  </td>
                  <td>
                      <input name="number" type="number" min="1" value="<%= s.number %>" required />
                  </td>
                  <td>
                      <select name="branch" required>
                        <% branches.forEach((b) => { %>
                          <option value="<%= b._id %>" <%= currentBranchId === b._id.toString() ? 'selected' : '' %>><%= b.name %></option>
                        <% }) %>
                      </select>
                  </td>
                  <td>
                      <button type="submit">Save</button>
                    </form>
                    <form action="/admin/semesters/<%= s._id %>?_method=DELETE" method="POST">
                      <button type="submit" onclick="return confirm('Delete semester?')">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section id="subjects" class="panel">
        <h3>Subjects</h3>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Name</th><th>Code</th><th>Semester</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% subjects.forEach((sub) => { const currentSemesterId = sub.semester?._id ? sub.semester._id.toString() : (sub.semester ? sub.semester.toString() : ''); %>
                <tr>
                  <td>
                    <form action="/admin/subjects/<%= sub._id %>?_method=PUT" method="POST" class="inline-edit-form">
                      <input name="name" value="<%= sub.name %>" required />
                  </td>
                  <td>
                      <input name="code" value="<%= sub.code || '' %>" />
                  </td>
                  <td>
                      <select name="semester" required>
                        <% semesters.forEach((s) => { %>
                          <option value="<%= s._id %>" <%= currentSemesterId === s._id.toString() ? 'selected' : '' %>><%= s.name %> - <%= s.branch?.name || 'N/A' %></option>
                        <% }) %>
                      </select>
                  </td>
                  <td>
                      <button type="submit">Save</button>
                    </form>
                    <form action="/admin/subjects/<%= sub._id %>?_method=DELETE" method="POST">
                      <button type="submit" onclick="return confirm('Delete subject?')">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </section>
  </div>
</main>
<%- include('../partials/footer') %>
