<%- include('../partials/header') %>
<main class="book-viewer-shell full-viewer" id="bookViewerShell">
  <section class="book-stage full-stage" id="bookStage">
    <div class="book-toolbar floating-toolbar">
      <div>
        <h2 class="book-title"><%= material.title %></h2>
        <p class="book-subtitle">Protected Reader | Session-secured stream | Expires in <span id="tokenTimer">05:00</span></p>
      </div>
      <div class="book-actions">
        <button type="button" id="fullScreenBtn" class="btn">Full Screen</button>
      </div>
    </div>
    <div class="book-watermark"><%= watermark %></div>
    <div class="html-viewer-container book-frame">
      <iframe 
        id="htmlFrame" 
        class="html-frame"
        sandbox="allow-same-origin allow-scripts allow-forms allow-popups"
        frameborder="0">
      </iframe>
      <div id="htmlErrorBox" class="pdf-error-box" style="display:none;">
        <p id="htmlErrorText">Unable to load material.</p>
        <button type="button" class="btn" id="retryHtmlBtn">Retry</button>
      </div>
    </div>
    <div class="book-gloss" aria-hidden="true"></div>
  </section>

  <p class="book-note">Security notice: This viewer blocks common shortcuts and uses expiring signed links. Absolute prevention of screenshots/camera capture is not technically possible on any web app.</p>
</main>

<script>
  document.body.classList.add('viewer-mode');

  const start = Date.now();
  const tokenExpiryMs = Number('<%= tokenExpiryMs %>') || 300000;
  const timerEl = document.getElementById('tokenTimer');
  const fullScreenBtn = document.getElementById('fullScreenBtn');
  const shell = document.getElementById('bookViewerShell');
  const htmlFrame = document.getElementById('htmlFrame');
  const htmlErrorBox = document.getElementById('htmlErrorBox');
  const htmlErrorText = document.getElementById('htmlErrorText');
  const retryHtmlBtn = document.getElementById('retryHtmlBtn');
  let loadingStarted = false;

  function showError(message) {
    htmlFrame.style.display = 'none';
    htmlErrorBox.style.display = 'flex';
    htmlErrorText.textContent = message || 'Unable to load material on this device.';
  }

  async function loadHtml() {
    if (loadingStarted) return;
    loadingStarted = true;
    htmlErrorBox.style.display = 'none';
    htmlFrame.style.display = 'block';

    try {
      const response = await fetch('<%= secureFileUrl %>', {
        method: 'GET',
        credentials: 'include',
        cache: 'no-store'
      });
      
      if (!response.ok) {
        const errorBody = await response.text();
        return showError(`Error (${response.status}): ${errorBody.slice(0, 150)}`);
      }

      const htmlContent = await response.text();
      
      if (!htmlContent || htmlContent.length === 0) {
        return showError('Empty material content');
      }

      // Write HTML to iframe
      const iframeDoc = htmlFrame.contentDocument || htmlFrame.contentWindow.document;
      iframeDoc.open();
      iframeDoc.write(htmlContent);
      iframeDoc.close();
    } catch (err) {
      showError(`Could not load material: ${err.message || 'Unknown error'}`);
    } finally {
      loadingStarted = false;
    }
  }

  retryHtmlBtn.addEventListener('click', () => {
    loadingStarted = false;
    loadHtml();
  });

  loadHtml();

  // Token expiry countdown
  const ticker = setInterval(() => {
    const elapsed = Date.now() - start;
    const left = Math.max(0, tokenExpiryMs - elapsed);
    const mins = String(Math.floor(left / 60000)).padStart(2, '0');
    const secs = String(Math.floor((left % 60000) / 1000)).padStart(2, '0');
    timerEl.textContent = `${mins}:${secs}`;
    if (left === 0) clearInterval(ticker);
  }, 1000);

  // Fullscreen toggle
  fullScreenBtn.addEventListener('click', async () => {
    if (!document.fullscreenElement) {
      await shell.requestFullscreen();
      fullScreenBtn.textContent = 'Exit Full Screen';
    } else {
      await document.exitFullscreen();
      fullScreenBtn.textContent = 'Full Screen';
    }
  });

  document.addEventListener('fullscreenchange', () => {
    fullScreenBtn.textContent = document.fullscreenElement ? 'Exit Full Screen' : 'Full Screen';
  });

  // Security deterrents
  document.addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    if (k === 'printscreen') {
      e.preventDefault();
      navigator.clipboard && navigator.clipboard.writeText('Screenshots are disabled in protected viewer.').catch(() => {});
    }
    if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u', 'o'].includes(k)) e.preventDefault();
    if (e.key === 'F12') e.preventDefault();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) document.body.classList.add('viewer-blur');
    else document.body.classList.remove('viewer-blur');
  });

  window.addEventListener('beforeunload', () => {
    const secondsSpent = Math.floor((Date.now() - start) / 1000);
    navigator.sendBeacon('/activity', new Blob([JSON.stringify({ materialId: '<%= material._id %>', secondsSpent })], { type: 'application/json' }));
  });
</script>
<%- include('../partials/footer') %>
