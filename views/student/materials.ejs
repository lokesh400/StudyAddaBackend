<%- include('../partials/header') %>
<main class="pw-layout">
  <section class="hero-card">
    <h1>Your Cohort Dashboard</h1>
    <p>Choose department, branch, semester and get subject-focused materials instantly.</p>
    <form method="POST" action="/cohort" class="cohort-grid" id="cohortForm">
      <select name="departmentId" id="departmentSelect" required>
        <option value="">Select Department</option>
        <% departments.forEach(d => { %><option value="<%= d._id %>" <%= cohort.department && String(cohort.department._id||cohort.department)===String(d._id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
      </select>
      <select name="branchId" id="branchSelect" required><option value="">Select Branch</option></select>
      <select name="semesterId" id="semesterSelect" required><option value="">Select Semester</option></select>
      <button type="submit">Apply Cohort</button>
    </form>
  </section>

  <section class="panel">
    <h2>Subjects in Your Cohort</h2>
    <div class="chips"><% if (subjects.length===0) { %><span class="chip">No subjects found yet</span><% } %><% subjects.forEach(s => { %><span class="chip"><%= s.name %></span><% }) %></div>
  </section>

  <section class="panel">
    <form method="GET" action="/materials" class="search-row">
      <input name="q" placeholder="Search notes, titles" value="<%= filters.q %>" />
      <select name="subject"><option value="">All Subjects</option><% subjects.forEach(s => { %><option value="<%= s._id %>" <%= String(filters.subject||'')===String(s._id) ? 'selected' : '' %>><%= s.name %></option><% }) %></select>
      <button type="submit">Search</button>
    </form>
    <div class="cards">
      <% materials.forEach(m => { %>
        <article class="material-card">
          <h3><%= m.title %></h3>
          <p><%= m.subject?.name %> | <%= m.branch?.name %> | <%= m.semester?.name %></p>
          <div class="actions">
            <a href="/materials/<%= m._id %>/read" class="btn">View</a>
            <form method="POST" action="/materials/<%= m._id %>/favorite"><button class="btn ghost">Favorite</button></form>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>
<script>
(async function(){
  const dept = document.getElementById('departmentSelect');
  const branch = document.getElementById('branchSelect');
  const sem = document.getElementById('semesterSelect');
  const selectedBranch = '<%= cohort.branch ? String(cohort.branch._id || cohort.branch) : "" %>';
  const selectedSemester = '<%= cohort.semester ? String(cohort.semester._id || cohort.semester) : "" %>';

  async function loadBranches(id){
    branch.innerHTML = '<option value="">Select Branch</option>'; sem.innerHTML='<option value="">Select Semester</option>';
    if(!id) return;
    const data = await fetch(`/api/departments/${id}/branches`).then(r=>r.json());
    data.forEach(b=>branch.innerHTML += `<option value="${b._id}">${b.name}</option>`);
    if(selectedBranch) { branch.value = selectedBranch; await loadSemesters(selectedBranch); }
  }
  async function loadSemesters(id){
    sem.innerHTML='<option value="">Select Semester</option>';
    if(!id) return;
    const data = await fetch(`/api/branches/${id}/semesters`).then(r=>r.json());
    data.forEach(s=>sem.innerHTML += `<option value="${s._id}">${s.name}</option>`);
    if(selectedSemester) sem.value = selectedSemester;
  }
  dept.addEventListener('change', e => loadBranches(e.target.value));
  branch.addEventListener('change', e => loadSemesters(e.target.value));
  if(dept.value) loadBranches(dept.value);
})();
</script>
<%- include('../partials/footer') %>
