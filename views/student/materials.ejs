<%- include('../partials/header') %>
<main class="pw-layout">
  <!-- Cohort Selection Button -->
  <div class="cohort-button-wrapper">
    <% 
      const cohortDisplay = cohort.department ? `${cohort.department.name} • ${cohort.branch?.name} • ${cohort.semester?.name}` : 'Select Your Cohort';
    %>
    <button class="cohort-selector-btn" id="cohortBtn">
      <span class="cohort-icon">📚</span>
      <span class="cohort-text"><%= cohortDisplay %></span>
      <span class="cohort-arrow">▼</span>
    </button>
  </div>

  <!-- Cohort Modal -->
  <div class="modal" id="cohortModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Choose Your Cohort</h2>
        <button class="modal-close" id="cohortModalClose">&times;</button>
      </div>
      <form method="POST" action="/cohort" class="cohort-modal-form" id="cohortForm">
        <label class="field">
          <span class="field-label">Department</span>
          <select name="departmentId" id="departmentSelect" required>
            <option value="">Select Department</option>
            <% departments.forEach(d => { %><option value="<%= d._id %>" <%= cohort.department && String(cohort.department._id||cohort.department)===String(d._id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
          </select>
        </label>
        <label class="field">
          <span class="field-label">Branch</span>
          <select name="branchId" id="branchSelect" required><option value="">Select Branch</option></select>
        </label>
        <label class="field">
          <span class="field-label">Semester</span>
          <select name="semesterId" id="semesterSelect" required><option value="">Select Semester</option></select>
        </label>
        <div class="modal-actions">
          <button type="button" class="btn ghost" id="cohortCancel">Cancel</button>
          <button type="submit" class="btn cohort-apply">Apply Cohort</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Subjects Grid -->
  <section class="panel">
    <h2>📖 Subjects in Your Cohort</h2>
    <% if (subjects.length === 0) { %>
      <div class="empty-state">
        <p>No subjects found</p>
        <p class="desc-text">Please select a valid cohort to see subjects</p>
      </div>
    <% } else { %>
      <div class="subjects-grid">
        <% subjects.forEach(s => { %>
          <div class="subject-card">
            <div class="subject-header">
              <h3><%= s.name %></h3>
              <span class="subject-icon">📚</span>
            </div>
            <div class="subject-content">
              <a href="/browse/<%= s._id %>" class="btn ghost">View Materials</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<script>
(async function(){
  // Cohort modal
  const cohortBtn = document.getElementById('cohortBtn');
  const cohortModal = document.getElementById('cohortModal');
  const cohortModalClose = document.getElementById('cohortModalClose');
  const cohortCancel = document.getElementById('cohortCancel');

  cohortBtn.addEventListener('click', () => cohortModal.classList.add('open'));
  cohortModalClose.addEventListener('click', () => cohortModal.classList.remove('open'));
  cohortCancel.addEventListener('click', () => cohortModal.classList.remove('open'));

  cohortModal.addEventListener('click', (e) => {
    if (e.target === cohortModal) cohortModal.classList.remove('open');
  });

  // Cohort selection
  const dept = document.getElementById('departmentSelect');
  const branch = document.getElementById('branchSelect');
  const sem = document.getElementById('semesterSelect');
  const selectedBranch = '<%= cohort.branch ? String(cohort.branch._id || cohort.branch) : "" %>';
  const selectedSemester = '<%= cohort.semester ? String(cohort.semester._id || cohort.semester) : "" %>';

  async function loadBranches(id){
    branch.innerHTML = '<option value="">Select Branch</option>'; sem.innerHTML='<option value="">Select Semester</option>';
    if(!id) return;
    const data = await fetch(`/api/departments/${id}/branches`).then(r=>r.json());
    data.forEach(b=>branch.innerHTML += `<option value="${b._id}">${b.name}</option>`);
    if(selectedBranch) { branch.value = selectedBranch; await loadSemesters(selectedBranch); }
  }
  async function loadSemesters(id){
    sem.innerHTML='<option value="">Select Semester</option>';
    if(!id) return;
    const data = await fetch(`/api/branches/${id}/semesters`).then(r=>r.json());
    data.forEach(s=>sem.innerHTML += `<option value="${s._id}">${s.name}</option>`);
    if(selectedSemester) sem.value = selectedSemester;
  }
  dept.addEventListener('change', e => loadBranches(e.target.value));
  branch.addEventListener('change', e => loadSemesters(e.target.value));
  if(dept.value) loadBranches(dept.value);
})();

// Hamburger menu
const hamburgerBtn = document.getElementById('hamburgerBtn');
const appbarActions = document.querySelector('.appbar-actions');
const profileBtn = document.getElementById('profileBtn');
const profileDropdown = document.getElementById('profileDropdown');

if (hamburgerBtn) {
  hamburgerBtn.addEventListener('click', () => {
    appbarActions.classList.toggle('open');
    if (appbarActions.classList.contains('open')) {
      profileDropdown.classList.add('open');
    } else {
      profileDropdown.classList.remove('open');
    }
  });
}

if (profileBtn) {
  profileBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    profileDropdown.classList.toggle('open');
  });

  document.addEventListener('click', () => {
    if (appbarActions && !appbarActions.classList.contains('open')) {
      profileDropdown.classList.remove('open');
    }
  });
}
</script>
<%- include('../partials/footer') %>

